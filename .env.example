NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=              # só no servidor, nunca com NEXT_PUBLIC
NEXT_PUBLIC_APP_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM=                      # ex.: Alicerce <nao-responda@seudominio.com.br>
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
ASAAS_ENV=sandbox                 # sandbox | production
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=              # token próprio, diferente da chave da API
CRON_SECRET=
WHATSAPP_TOKEN=                   # token permanente da WhatsApp Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=         # id do número, no painel da Meta
WHATSAPP_VERIFY_TOKEN=            # token que você inventa, para a Meta verificar o webhook
WHATSAPP_APP_SECRET=              # app secret da Meta, para conferir a assinatura do webhook
NFSE_PROVIDER=                    # ex.: focus | plugnotas | nuvemfiscal
NFSE_ENV=homologacao              # homologacao | producao
NFSE_API_KEY=
NFSE_WEBHOOK_TOKEN=               # token próprio, para o provedor provar que é ele

# Só para rodar os testes de banco num Postgres local (veja scripts/db-local.sh)
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/alicerce_test
